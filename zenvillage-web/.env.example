# ──────────────────────────────────────────────────────────────
# ZenAndVillage Web — environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing secrets.
# ──────────────────────────────────────────────────────────────

# Base URL for the HTTP API (no trailing slash)
# Example: https://api.dev.zenvillage.io
VITE_API_BASE_URL=https://api.dev.zenvillage.io

# WebSocket endpoint (wss://) for real-time notifications
# Example: wss://ws.dev.zenvillage.io
VITE_WS_ENDPOINT=wss://ws.dev.zenvillage.io

# AWS Cognito — User Pool ID and App Client ID
# Retrieve from AWS Console or CDK stack outputs
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# AWS Region where Cognito and API Gateway are deployed
VITE_AWS_REGION=us-east-1
