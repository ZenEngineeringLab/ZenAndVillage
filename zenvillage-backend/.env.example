# AWS Region
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# These values are exported by CDK to SSM — read from there in staging/prod
# For local dev, copy from SSM or CDK outputs after first deploy
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
API_URL=
WS_URL=

# DynamoDB Table Names (set by CDK env vars on each Lambda)
TENANTS_TABLE=zenvillage-tenants-staging
PROPERTY_MANAGERS_TABLE=zenvillage-property-managers-staging
CONDOMINIUMS_TABLE=zenvillage-condominiums-staging
RESIDENTS_TABLE=zenvillage-residents-staging
EMPLOYEES_TABLE=zenvillage-employees-staging
NOTIFICATIONS_TABLE=zenvillage-notifications-staging
CONNECTIONS_TABLE=zenvillage-connections-staging
FILES_TABLE=zenvillage-files-staging
USERS_TABLE=zenvillage-users-staging

# S3
UPLOADS_BUCKET=zenvillage-uploads-staging
