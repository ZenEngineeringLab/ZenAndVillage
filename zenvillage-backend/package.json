{
  "name": "zenvillage-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "ZenAndVillage serverless backend — AWS Lambda + CDK",
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "cdk": "cdk",
    "deploy:staging": "cdk deploy --all --require-approval never --context env=staging",
    "deploy:prod": "cdk deploy --all --require-approval broadening --context env=prod",
    "seed": "ts-node --esm scripts/seed.ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.13.0",
    "@aws-lambda-powertools/metrics": "^2.13.0",
    "@aws-lambda-powertools/tracer": "^2.13.0",
    "@aws-lambda-powertools/idempotency": "^2.13.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.782.0",
    "@aws-sdk/client-dynamodb": "^3.782.0",
    "@aws-sdk/lib-dynamodb": "^3.782.0",
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-presigned-post": "^3.782.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.782.0",
    "@aws-sdk/client-eventbridge": "^3.782.0",
    "@aws-sdk/client-ssm": "^3.782.0",
    "@middy/core": "^7.0.0",
    "@middy/http-json-body-parser": "^7.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.21",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.200.1",
    "aws-cdk-lib": "^2.200.1",
    "constructs": "^10.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  }
}
